# MIND MAZE 2.0 - Environment Configuration Template
# Copy this file to .env.local and fill in your Supabase project credentials.
# NEVER commit .env.local or secret keys (service_role) to version control.

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Client Key (Safe for browser applications)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Base path for deployment (e.g. /treasure-hunt-arena/ or ./ for relative)
VITE_BASE_PATH=./

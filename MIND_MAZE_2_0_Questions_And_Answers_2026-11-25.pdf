(function solve\(coords\) {) Tj
T* (  // Your code here) Tj
T* (  let perimeter = 0;) Tj
T* (  const n = coords.length;) Tj
T* (  for \(let i = 0; i < n; i++\) {) Tj
T* (    const next = \(i + 1\) % n;) Tj
T* (    const dx = coords[next][0] - coords[i][0];) Tj
T* (    const dy = coords[next][1] - coords[i][1];) Tj
T* (    perimeter += Math.sqrt\(dx * dx + dy * dy\);) Tj
T* (  }) Tj
T* (  return Math.round\(perimeter * 100\) / 100;) Tj
T* (}) Tj

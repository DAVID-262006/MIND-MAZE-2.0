(function solve\(n\) {) Tj
T* (  // Your code here) Tj
T* (  let total = 0;) Tj
T* (  for \(let k = 1; k <= n; k++\) {) Tj
T* (    const term = \(k * 3\) + \(k % 2 === 0 ? k / 2 : k * 2\);) Tj
T* (    total += term;) Tj
T* (  }) Tj
T* (  return total;) Tj
T* (}) Tj

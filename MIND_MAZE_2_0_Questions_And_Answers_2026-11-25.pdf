(function solve\(hops\) {) Tj
T* (  // Your code here) Tj
T* (  let maxDrop = 0;) Tj
T* (  for \(let i = 0; i < hops.length - 1; i++\) {) Tj
T* (    const drop = hops[i] - hops[i + 1];) Tj
T* (    if \(drop > maxDrop\) {) Tj
T* (      maxDrop = drop;) Tj
T* (    }) Tj
T* (  }) Tj
T* (  return maxDrop;) Tj
T* (}) Tj
